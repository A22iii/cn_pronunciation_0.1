# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*$py.class
*.pyd

# =========================
# Virtual environments
# =========================
.venv/
venv/
env/
ENV/
.conda/

# =========================
# Environment variables, certificates, and secrets
# =========================
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
secrets/

# =========================
# IDE / editor files
# =========================
.vscode/
.idea/
*.iml
*.swp
*.swo

# =========================
# Operating-system files
# =========================
.DS_Store
Thumbs.db
desktop.ini

# =========================
# Runtime files, caches, logs, and temporary files
# =========================
.gradio/
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.ipynb_checkpoints/
*.log
*.tmp
*.temp
*.bak
tmp/
temp/

# =========================
# Python packaging / build output
# =========================
build/
dist/
*.egg-info/
.eggs/

# =========================
# User recordings and generated data
# =========================
recordings/
uploads/
data/raw/
data/processed/
data/cache/
output/
outputs/
results/
reports/generated/

# =========================
# Audio files
# Batch recordings and generated audio should not be committed by default.
# Small, intentional samples below are explicitly allowed.
# =========================
*.wav
*.mp3
*.flac
*.m4a
*.aac
*.ogg
*.wma

!example/
!example/*.wav
!tests/
!tests/audio/
!tests/audio/*.wav
!examples/
!examples/audio/
!examples/audio/*.wav

# =========================
# Praat generated object files
# Keep *.TextGrid available for human annotations.
# =========================
*.Pitch
*.Formant
*.Intensity
*.Spectrogram
*.Ltas
*.Manipulation
*.PointProcess
*.DurationTier
*.Harmonicity
*.TextGrid~

# =========================
# Datasets, models, and checkpoints
# =========================
dataset/
datasets/
models/
checkpoints/
weights/
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.joblib
*.pkl

# =========================
# Local-only configuration
# =========================
config.local.*
settings.local.*
